{
  "name": "debezium-source-crm",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",
    "database.hostname": "127.0.0.1",
    "database.port": "3307",
    "database.user": "ai_user_stjul6",
    "database.password": "aidb123##@1234AsfghQ",
    "database.server.id": "184054",
    "topic.prefix": "crm",
    "database.include.list": "crm,goglo_staging",
    "table.include.list": "crm.rfqs,crm.crm_leads,crm.lead_master,crm.trade_relationship,crm.page_visits,crm.scroll_depths,crm.session_engagements,goglo_staging.tracking_sessions,goglo_staging.tracking_click_events,goglo_staging.tracking_page_views,goglo_staging.enquiries",
    "schema.history.internal.kafka.bootstrap.servers": "localhost:9092",
    "schema.history.internal.kafka.topic": "schema-history.crm",
    "include.schema.changes": "false",
    "snapshot.mode": "initial",
    "snapshot.locking.mode": "none",
    "decimal.handling.mode": "string",
    "time.precision.mode": "connect",

    "transforms": "routeRfq,routeSessions,routeClicks,routeLeads",

    "transforms.routeRfq.type": "io.debezium.transforms.ByLogicalTableRouter",
    "transforms.routeRfq.topic.regex": "crm\\.rfq",
    "transforms.routeRfq.topic.replacement": "crm.rfq_submitted",
    "transforms.routeRfq.key.enforce.uniqueness": "false",

    "transforms.routeSessions.type": "io.debezium.transforms.ByLogicalTableRouter",
    "transforms.routeSessions.topic.regex": "crm\\.sessions",
    "transforms.routeSessions.topic.replacement": "crm.buyer_sessions",
    "transforms.routeSessions.key.enforce.uniqueness": "false",

    "transforms.routeClicks.type": "io.debezium.transforms.ByLogicalTableRouter",
    "transforms.routeClicks.topic.regex": "crm\\.clicks",
    "transforms.routeClicks.topic.replacement": "crm.buyer_clicks",
    "transforms.routeClicks.key.enforce.uniqueness": "false",

    "transforms.routeLeads.type": "io.debezium.transforms.ByLogicalTableRouter",
    "transforms.routeLeads.topic.regex": "crm\\.leads",
    "transforms.routeLeads.topic.replacement": "crm.lead_updates",
    "transforms.routeLeads.key.enforce.uniqueness": "false"
  }
}
